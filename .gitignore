# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pdb
*.egg
*.egg-info/
*.manifest
*.spec

# --- Virtualenvs ---
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# --- Logs ---
*.log
*.out
*.err

# --- Build artifacts ---
build/
dist/
develop-eggs/
.eggs/
parts/
sdist/
wheels/
pip-wheel-metadata/
share/python-wheels/

# --- IDE ---
.idea/
*.iml

# --- Checkpoints (keep best_model.pt under Models/; ignore intermediates in Runs/) ---
*.pth
*.ckpt
Runs/**/last.pt
Runs/**/checkpoint_epoch*.pt
Legacy/Runs/**/last.pt
Legacy/Runs/**/checkpoint_epoch*.pt
# Ignore loose .pt at repo root / run folders unless under Models/
*.pt
!Models/Pytorch/*.pt
!Legacy/Models/Pytorch/*.pt
!Legacy/Models/**/*.pt

# --- Local workspace (caches, scratch, logs) ---
Workspace/prepared/
Workspace/exports/
Workspace/logs/
Workspace/scratch/
/prepared/
/exports/
/reports/

# --- Legacy local training dirs (pre-reorg names; avoid /runs/ — case-insensitive FS clashes with Runs/) ---
/runs_*/
/data/
/datasets/
/outputs/
/dataset/
# Explicitly keep the PascalCase Runs/ tree trackable
!/Runs/
!/Runs/**/

# --- Regenerated locally ---
fingerprints.bin
Legacy/Fase1Fingerprints/runs_pilot/

# --- Xcode user state ---
**/xcuserdata/
*.xcuserstate

# --- Temp ---
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store

# --- Docs: ignore ad-hoc markdown, keep README/AGENTS/skills ---
*.md
!README.md
!AGENTS.md
!**/README.md
!**/AGENTS.md
!.cursor/skills/**/*.md
!**/SKILL.md
